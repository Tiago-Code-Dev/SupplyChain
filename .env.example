# ============================================
# CONFIGURAÇÃO DO SERVIDOR - Employee Management
# ============================================
# 
# IMPORTANTE: Este arquivo é para o ADMINISTRADOR DO SISTEMA.
# O usuário final NÃO precisa fazer nenhuma configuração.
# Após configurado, o sistema de "Esqueci minha senha" funciona automaticamente.
#
# INSTRUÇÕES PARA O ADMINISTRADOR:
# 1. Copie este arquivo para .env (sem .example)
# 2. Preencha com as credenciais do servidor de email
# 3. Reinicie o Docker: docker-compose up -d
#
# ============================================

# ===== GMAIL (RECOMENDADO) =====
# 1. Ative verificação em 2 etapas: https://myaccount.google.com/security
# 2. Crie Senha de App: https://myaccount.google.com/apppasswords
# 3. Escolha "Email" e copie a senha de 16 caracteres

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=seu-email@gmail.com
EMAIL_USERNAME=seu-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_USE_SSL=true
EMAIL_ENABLE_SENDING=true

# ===== OUTLOOK/HOTMAIL =====
# EMAIL_SMTP_SERVER=smtp-mail.outlook.com
# EMAIL_SMTP_PORT=587
# EMAIL_SENDER=seu-email@hotmail.com
# EMAIL_USERNAME=seu-email@hotmail.com
# EMAIL_PASSWORD=sua-senha
# EMAIL_USE_SSL=true
# EMAIL_ENABLE_SENDING=true

# ===== MAILTRAP (DESENVOLVIMENTO/TESTES - Gratuito) =====
# Crie conta em: https://mailtrap.io
# EMAIL_SMTP_SERVER=sandbox.smtp.mailtrap.io
# EMAIL_SMTP_PORT=2525
# EMAIL_SENDER=noreply@test.com
# EMAIL_USERNAME=seu-username-mailtrap
# EMAIL_PASSWORD=sua-senha-mailtrap
# EMAIL_USE_SSL=false
# EMAIL_ENABLE_SENDING=true
